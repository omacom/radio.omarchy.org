    "configure:station": "node scripts/configure-station.mjs",
    "prepare:catalog": "node --env-file-if-exists=.env scripts/prepare-catalog.mjs",
    "dev:web": "node scripts/serve-web.mjs",
    "demo": "node scripts/demo.mjs"
  }
}
