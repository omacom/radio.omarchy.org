# Local server and persistent station volume.
PORT=8787
BIND=127.0.0.1
RADIO_DATA=var
# Choose a Responses API model available to your account.
OPENAI_API_KEY=
OPENAI_MODEL=
# Set elevenlabs for broadcast speech. local uses espeak-ng for development.
TTS_PROVIDER=local
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Optional source credentials. Public GitHub sources work without a token.
GITHUB_TOKEN=
GITHUB_MAINTAINERS=dhh
X_BEARER_TOKEN=
X_ACCOUNTS=dhh
SOURCES_ENABLED=true
# Private operational inspection at /api/ops.
OPS_TOKEN=

# Comma-separated frontend origins. Add http://127.0.0.1:8790 for split-host local tests.
ALLOWED_ORIGINS=https://radio.omarchy.org
