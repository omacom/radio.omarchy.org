---
/* The controls. These stay ordinary DOM: a shader that moves a button's
 * picture without moving its hit box is a button that misses.
 *
 * The play button carries both faces and shows one: the deck flips a class
 * rather than rewriting the button, so nothing here is drawn twice or drawn
 * in JavaScript. */
import Icon from './Icon.astro';
---
<section class="transport" aria-label="Playback controls">
  <div class="tbtns">
    <button type="button" class="tb" id="prev" aria-label="Previous track"><Icon name="prev" /></button>
    <button type="button" class="tb tb-play" id="toggle" aria-label="Play or pause"><Icon name="play" /><Icon name="pause" /></button>
    <button type="button" class="tb" id="stop" aria-label="Stop"><Icon name="stop" /></button>
    <button type="button" class="tb" id="next" aria-label="Next track"><Icon name="next" /></button>
  </div>

  <div class="seek" id="seek" role="slider" tabindex="0" aria-label="Seek" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
    <div class="seek-track">
      <div class="seek-fill" id="seekFill"></div>
      <div class="seek-head" id="seekHead"></div>
    </div>
  </div>

  <div class="knobs">
    <div class="knob-wrap">
      <span class="knob-lbl">vol</span>
      <div class="knob" id="volKnob" role="slider" tabindex="0" aria-label="Volume" aria-valuemin="0" aria-valuemax="100" aria-valuenow="80">
        <div class="knob-rot" id="volRot"><span class="knob-tick"></span></div>
      </div>
      <span class="knob-val" id="volLabel">80</span>
    </div>
  </div>
</section>
