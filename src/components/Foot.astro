---
/* The status line, the theme picker, and the install button that only ever
 * appears once the browser has said it would actually install. */
import Icon from './Icon.astro';
---
<footer class="foot">
  <p class="status"><span class="pulse" aria-hidden="true"></span><span id="status">ready</span></p>
  <div class="picker">
    <button type="button" class="picker-btn" id="themeBtn" aria-expanded="false" aria-controls="themeMenu" aria-haspopup="listbox">
      <span class="picker-name">
        <span class="sw-ac" aria-hidden="true"></span>
        <span id="skinName">green</span>
      </span>
      <span class="caret" id="themeCaret" aria-hidden="true"><Icon name="caret-down" /><Icon name="caret-up" /></span>
    </button>
    <ul class="menu" id="themeMenu" role="listbox" aria-label="Colour theme" hidden></ul>
  </div>
  <button type="button" class="install" id="installBtn" hidden>install app</button>
</footer>
